# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual env
.venv/
venv/
ENV/

# Data (the optional Kaggle fallback CSV is 560 MB - over GitHub's 100 MB
# limit, and live/processed data is fetched or regenerated at runtime)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models (regenerated by the pipeline)
models/*
!models/.gitkeep

# Reports (generated figures/screenshots)
reports/*
!reports/.gitkeep

# Generated HTML export bundle (output/FoodIntel_AI_filled.html + vendor copy)
output/

# Caches
.pytest_cache/

# Streamlit (ship the required config; ignore secrets)
.streamlit/*
!.streamlit/config.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Env
.env
